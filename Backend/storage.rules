rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Defense-in-depth security rules for KYC worker documents
    match /worker-documents/{workerId}/{allPaths=**} {
      // Allow write/read if user is authenticated and is the worker owner OR an admin
      allow read, write: if request.auth != null && (
        firestore.get(/databases/(default)/documents/workers/$(request.auth.uid)).data.userId == request.auth.uid ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
      );
    }
  }
}
